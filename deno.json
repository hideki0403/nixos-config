{
	"$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
	"workspace": ["./cli", "./tests/workflow"],
	"lock": {
		"path": "deno.lock",
		"frozen": true
	},
	"tasks": {
		"check": "deno check .",
		"lint": "deno lint",
		"fmt": "deno fmt --check"
	},
	"compilerOptions": {
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true
	},
	"lint": {
		"include": ["./**/*.ts"],
		"exclude": [],
		"rules": {
			"tags": ["recommended"]
		}
	},
	"fmt": {
		"include": ["./**/*.ts"],
		"exclude": [],
		"useTabs": true,
		"indentWidth": 4,
		"lineWidth": 200,
		"semiColons": false,
		"singleQuote": true
	}
}
