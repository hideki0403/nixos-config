{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
  ],
  nix: {
    enabled: true,
  },
  timezone: 'Asia/Tokyo',
  minimumReleaseAge: '7 days',
  baseBranchPatterns: [
    'master',
  ],
  rebaseWhen: 'behind-base-branch',
  customManagers: [
    // Auto update nix-shell dependency in cli.sh
    {
      customType: 'regex',
      managerFilePatterns: ['/^cli\\.sh$/'],
      matchStrings: [
        '#!nix-shell -I nixpkgs=https://github\\.com/NixOS/nixpkgs/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz\\n#@nixpkgs: (?<currentValue>nixos-\\d+\\.\\d+)'
      ],
      depNameTemplate: 'nix-shell',
      packageNameTemplate: 'https://github.com/NixOS/nixpkgs.git',
      datasourceTemplate: 'git-refs',
      versioningTemplate: 'regex:^nixos-(?<major>\\d+)\\.(?<minor>\\d+)$',
      autoReplaceStringTemplate: '#!nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/{{{newDigest}}}.tar.gz\n#@nixpkgs: {{{newValue}}}'
    }
  ],
  packageRules: [
    {
      groupName: 'all-dependencies',
      groupSlug: 'all',
      matchPackageNames: ['*'],
    },
    {
      matchUpdateTypes: ['major'],
      addLabels: ['renovate:major'],
    },
    {
      groupName: 'nixos',
      groupSlug: 'nixos',
      matchManagers: ['nix'],
      minimumReleaseAge: null,
      addLabels: ['renovate:nixos'],
    },
    {
      groupName: 'nix-shell',
      groupSlug: 'nix-shell',
      matchDepNames: ['nix-shell'],
      minimumReleaseAge: null,
    },
    {
      groupName: 'deno',
      groupSlug: 'deno',
      matchManagers: ['deno'],
    },
    {
      groupName: 'github-actions',
      groupSlug: 'github-actions',
      matchManagers: ['github-actions'],
    }
  ],
  lockFileMaintenance: {
    enabled: true,
    commitMessageSuffix: '({{{manager}}})',
    schedule: 'at any time',
  },
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
}
