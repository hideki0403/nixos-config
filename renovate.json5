{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
  ],
  nix: {
    enabled: true,
  },
  timezone: 'Asia/Tokyo',
  minimumReleaseAge: '7 days',
  baseBranchPatterns: [
    'master',
  ],
  customManagers: [
    // Auto update nix-shell dependency in cli.sh
    {
      customType: 'regex',
      managerFilePatterns: ['/^cli\\.sh$/'],
      matchStrings: [
        '#!nix-shell -I nixpkgs=https://github\\.com/NixOS/nixpkgs/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz\\n#@nixpkgs: (?<currentValue>nixos-\\d+\\.\\d+)'
      ],
      depNameTemplate: 'nix-shell',
      packageNameTemplate: 'https://github.com/NixOS/nixpkgs.git',
      datasourceTemplate: 'git-refs',
      versioningTemplate: 'regex:^nixos-(?<major>\\d+)\\.(?<minor>\\d+)$',
      autoReplaceStringTemplate: '#!nix-shell -I nixpkgs=https://github.com/NixOS/nixpkgs/archive/{{{newDigest}}}.tar.gz\n#@nixpkgs: {{{newValue}}}'
    }
  ],
  packageRules: [
    {
      groupName: 'all-dependencies',
      groupSlug: 'all',
      matchPackageNames: ['*'],
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      groupName: 'nixos',
      groupSlug: 'nixos',
      matchManagers: ['nix'],
      minimumReleaseAge: null,
      automerge: true,
    },
    {
      groupName: 'nix-shell',
      groupSlug: 'nix-shell',
      matchDepNames: ['nix-shell'],
      minimumReleaseAge: null,
      schedule: '* 0-3 1 * *',
      automerge: true,
    },
    {
      groupName: 'deno',
      groupSlug: 'deno',
      matchManagers: ['deno'],
      automerge: true,
    },
  ],
  automerge: true,
  automergeType: 'pr',
  platformAutomerge: true,
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    commitMessageSuffix: '({{{manager}}})',
  },
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  schedule: [
    '* 0-3 * * 6',
  ],
}
